{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/geekforbrains/overlord/main/docs/schemas/output.schema.json",
  "title": "Overlord CLI JSON output",
  "description": "The single JSON document emitted by an Overlord command invoked with --json.",
  "type": "object",
  "required": ["schemaVersion", "command", "status"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2,
      "description": "Incremented for breaking changes to this document."
    },
    "overlordVersion": {
      "type": "string",
      "description": "Semver of the CLI that produced this document."
    },
    "command": {
      "enum": ["init", "status", "check", "sync"]
    },
    "status": {
      "enum": ["ok", "attention-required", "error"]
    },
    "error": { "$ref": "#/$defs/error" },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scope" }
    },
    "definitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/definition" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "timing": { "$ref": "#/$defs/timing" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "error" } },
        "required": ["status"]
      },
      "then": {
        "allOf": [
          { "required": ["error"] },
          {
            "properties": {
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "status": { "const": "completed" } }
                }
              }
            }
          },
          {
            "not": {
              "anyOf": [
                { "required": ["scopes"] },
                { "required": ["definitions"] },
                { "required": ["summary"] },
                { "required": ["diagnostics"] }
              ]
            }
          }
        ]
      },
      "else": {
        "allOf": [
          { "not": { "required": ["error"] } },
          { "required": ["scopes", "definitions", "summary", "actions", "diagnostics"] }
        ]
      }
    }
  ],
  "$defs": {
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/",
      "description": "An absolute filesystem path."
    },
    "state": {
      "enum": ["synced", "missing", "unadopted", "conflict", "invalid"]
    },
    "kind": { "enum": ["skill", "agent"] },
    "targetName": { "enum": ["claude", "codex"] },
    "scopeType": { "enum": ["user", "project"] },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": ["usage", "config-invalid", "lock-held", "permission-denied", "internal"]
        },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "detail": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["type", "path", "canonical"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/scopeType" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "canonical": { "$ref": "#/$defs/absolutePath" },
        "discoveryRoot": { "$ref": "#/$defs/absolutePath" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "project" } }, "required": ["type"] },
          "then": { "required": ["discoveryRoot"] },
          "else": { "not": { "required": ["discoveryRoot"] } }
        }
      ]
    },
    "definition": {
      "type": "object",
      "required": ["kind", "name", "scope", "scopePath", "state", "canonical", "outputs"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "name": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/scopeType" },
        "scopePath": { "$ref": "#/$defs/absolutePath" },
        "state": { "$ref": "#/$defs/state" },
        "canonical": {
          "oneOf": [
            { "$ref": "#/$defs/absolutePath" },
            { "type": "null" }
          ]
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/output" }
        },
        "evidence": { "type": "string" },
        "conflictsWith": {
          "type": "array",
          "items": { "$ref": "#/$defs/absolutePath" }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["target", "path", "state"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/targetName" },
        "path": { "$ref": "#/$defs/absolutePath" },
        "state": { "$ref": "#/$defs/state" },
        "readsCanonicalDirectly": { "type": "boolean" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "byState", "managed"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "byState": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/state" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "managed": { "type": "integer", "minimum": 0 }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "status", "description", "scope", "scopePath"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["planned", "completed"] },
        "description": { "type": "string" },
        "scope": { "$ref": "#/$defs/scopeType" },
        "scopePath": { "$ref": "#/$defs/absolutePath" },
        "reads": {
          "type": "array",
          "items": { "$ref": "#/$defs/absolutePath" }
        },
        "writes": {
          "type": "array",
          "items": { "$ref": "#/$defs/absolutePath" }
        },
        "removes": {
          "type": "array",
          "items": { "$ref": "#/$defs/absolutePath" }
        },
        "backups": {
          "type": "array",
          "items": { "$ref": "#/$defs/absolutePath" }
        },
        "commit": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "gitCommit": {
      "type": "object",
      "required": ["repository", "sha", "message", "files"],
      "additionalProperties": false,
      "properties": {
        "repository": { "$ref": "#/$defs/absolutePath" },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "message": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/absolutePath" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/absolutePath" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "message"],
      "additionalProperties": false,
      "properties": {
        "severity": { "enum": ["info", "warning", "error"] },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "path": { "type": "string" },
        "scopePath": { "$ref": "#/$defs/absolutePath" },
        "suggestion": { "type": "string" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "totalMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
